# Per-notebook data + outputs under docs/examples/* — checked-in
# notebooks reference these but the actual binary blobs (era5 .tif /
# .nc, GEE export tifs) are reproduced on demand by running the
# notebooks against live services. They must NOT enter git.

docs/examples/ecmwf/data/
docs/examples/gee/out/
docs/examples/cmems/data/
docs/examples/fdsn/fdsn_output/
docs/examples/tropycal/tropycal_output/
docs/examples/hdx/hdx_output/
docs/examples/overture/_overture_out/
docs/examples/usgs-water/_nb_out/
docs/examples/sentinel-hub/data/
docs/examples/jaxa/ptree_out/
docs/examples/caravan/outputs/
docs/examples/heatwave/out/
docs/examples/showcases/out/

# The same shapes, matched by pattern so a new notebook's output directory is
# ignored without editing this list. Kept in step with the `exclude_docs`
# globs in mkdocs.yml, which keep these out of the built site.
docs/examples/*/out/
docs/examples/*/*/out/
docs/examples/*/data/
docs/examples/*/*/data/
docs/examples/*/earthlens-data/
docs/examples/*/*/earthlens-data/
docs/examples/*/_nb_out/
docs/examples/*/*/_nb_out/
docs/examples/*/_overture_out/
docs/examples/*/*/_overture_out/
docs/examples/*/*_out/
docs/examples/*/*/*_out/
docs/examples/*/*_output/
docs/examples/*/*/*_output/
docs/examples/*/ohsome_log/
docs/examples/*/*/ohsome_log/
docs/examples/*/insar_stack*/
docs/examples/*/*/insar_stack*/
docs/examples/*/soilgrids_*/
docs/examples/*/*/soilgrids_*/

# Executed copies of the docs notebooks, mirroring docs/examples/ one directory
# per backend. Running a notebook writes its outputs back into the .ipynb, so
# these carry embedded figures and result blobs that the tracked, stripped
# originals deliberately do not. Root-anchored, since only the top-level tree
# is the executed mirror.
/executed-notebooks/

# Loose working media in the repo root and under docs/: scratch renders and
# source clips that are not part of the documentation. Ignored rather than
# deleted -- they are working files, but they are large and sit exactly where
# a `git add .` would sweep them into a commit.
/assets/
docs/videos/

# The satellite showcase's master mp4. render_master draws every frame into it
# once and publish_clip derives every published size from it by transcoding, so
# the master is an intermediate: 27 MB that nothing references. Re-rendering
# writes a byte-different copy each time, and video does not delta-compress, so
# committing it costs its full size again on every render.
docs/_images/animation/*-1920.mp4

# Loose branding working files beside the curated kit: the zip of the kit,
# exploration variants, and duplicates of assets the kit already ships. The
# kit itself (docs/_images/branding/earthlens-brand-kit/) stays tracked.
docs/_images/branding/*.svg
docs/_images/branding/*.gif
docs/_images/branding/*.png
docs/_images/branding/*.webp
docs/_images/branding/*.zip
docs/_images/branding/*.md

# Ad-hoc agent / verification scratch dropped in the repo root (notebook
# compile checks, result dumps). Anchored to root so src/ `_helpers.py`-style
# files are unaffected.
/_*.py
/_*.txt
/_*.json
/_*.log

# PyCharm-injected debugger / Jupyter-debug support libs (e.g.
# 261_24374_152-pycharm-support-libs/ with pydev/ + jupyter_debug/).
*-pycharm-support-libs/
