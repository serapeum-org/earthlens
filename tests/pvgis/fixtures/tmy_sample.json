    "type": "time series",
    "timestamp": "hourly",
    "variables": {
     "T2m": {
      "description": "2-m air temperature",
      "units": "degree Celsius"
     },
     "RH": {
      "description": "relative humidity",
      "units": "%"
     },
     "G(h)": {
      "description": "Global irradiance on the horizontal plane",
